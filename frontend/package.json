{
    "name": "power-bi-sample-data-frontend",
    "description": "Power BI 示例数据生成器前端",
    "author": "焦棚子 <jiaopengzi@qq.com>",
    "license": "MIT",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check build-only",
        "build-only": "vite build",
        "preview": "vite preview",
        "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt --write src/",
        "test": "vitest run",
        "testOnline": "vitest"
    },
    "dependencies": {
        "@element-plus/icons-vue": "2.3.2",
        "element-plus": "2.14.4",
        "vue": "3.5.41",
        "vue-i18n": "11.4.8"
    },
    "devDependencies": {
        "@tsconfig/node24": "24.0.4",
        "@types/node": "24.13.3",
        "@vitejs/plugin-vue": "6.0.8",
        "@vue/test-utils": "2.4.11",
        "@vue/tsconfig": "0.9.1",
        "jsdom": "30.0.1",
        "npm-run-all": "4.1.5",
        "oxfmt": "0.63.0",
        "oxlint": "1.78.0",
        "sass": "1.102.0",
        "typescript": "6.0.3",
        "vite": "8.2.1",
        "vitest": "4.1.10",
        "vue-tsc": "3.3.9"
    },
    "packageManager": "pnpm@11.21.0"
}