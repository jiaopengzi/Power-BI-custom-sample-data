{
    "extends": "@tsconfig/node24/tsconfig.json",
    "include": [
        "vite.config.*",
        "vitest.config.*"
    ],
    "compilerOptions": {
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        // vitest.config.ts 通过 import viteConfig from "./vite.config.ts" 引入配置, 需允许 .ts 扩展名导入
        "allowImportingTsExtensions": true,
        "types": [
            "node"
        ]
    }
}