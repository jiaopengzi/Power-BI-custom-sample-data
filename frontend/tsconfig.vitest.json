{
    "extends": "./tsconfig.app.json",
    "include": [
        "env.d.ts",
        "src/**/*.ts",
        "src/**/*.vue"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "coverage"
    ],
    "compilerOptions": {
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
        "lib": [
            "ES2025",
            "DOM",
            "DOM.Iterable"
        ],
        "types": [
            "node",
            "jsdom"
        ]
    }
}