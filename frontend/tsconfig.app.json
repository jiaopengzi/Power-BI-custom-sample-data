{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": [
        "env.d.ts",
        "src/**/*.ts",
        "src/**/*.vue"
    ],
    "exclude": [
        "src/**/__tests__/*",
        "dist",
        "node_modules",
        "wailsjs"
    ],
    "compilerOptions": {
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "noEmit": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true
    }
}